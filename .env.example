# SMARRTIF AI Environment Variables Configuration

APP_NAME="SMARRTIF AI — AI Career Profile Analyzer"
VERSION="1.0.0"
DEBUG=True

# Database (MongoDB Atlas or Local MongoDB)
# If left blank or unreachable, the application automatically falls back to persistent JSON/In-Memory mode.
MONGODB_URI=mongodb://localhost:27017/smarrtif_ai

# External API Integrations (Optional)
# Increases public GitHub API rate limit from 60 to 5,000 requests/hr
GITHUB_TOKEN=

# Optional OpenAI key for deep LLM bullet rewriter. Baseline spaCy + NLTK works 100% locally without keys.
OPENAI_API_KEY=

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]
